{
  "name": "dota-stats-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "start:web": "srvx --prod --host=0.0.0.0 --port=3000 --static=../client --entry=dist/server/server.js",
    "build": "pnpm build:web && pnpm build:cli",
    "build:cli": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "test": "node --test --enable-source-maps dist/tests/**/*.test.js",
    "check": "pnpm check:cli && pnpm check:web",
    "check:cli": "tsc -p tsconfig.json --noEmit",
    "check:web": "tsc -p tsconfig.web.json --noEmit",
    "test:web": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-sql": "6.10.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "@tanstack/pacer": "0.22.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-start": "1.168.48",
    "@uiw/react-codemirror": "4.25.11",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "srvx": "0.12.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.10.0"
}
